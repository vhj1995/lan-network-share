<Window x:Class="LANShare.CSharp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - LAN Network Share" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Device Name -->
            <TextBlock Text="Device Name:" FontSize="13" FontWeight="SemiBold" Foreground="#BAC2DE" Margin="0,0,0,5"/>
            <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,5"
                     Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,15"/>

            <!-- Download Directory -->
            <TextBlock Text="Save Downloaded Files To:" FontSize="13" FontWeight="SemiBold" Foreground="#BAC2DE" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,5"
                         Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" BorderThickness="1"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseDownloadDirCommand}" Width="80" Height="32" Margin="10,0,0,0"
                        Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
            </Grid>

            <!-- Network Ports -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Broadcast UDP Port:" FontSize="12" Foreground="#BAC2DE" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding BroadcastPort, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,5"
                             Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Transfer TCP Port:" FontSize="12" Foreground="#BAC2DE" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TransferPort, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,5"
                             Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Width="90" Height="34" Margin="0,0,10,0"
                    Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Width="90" Height="34"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
