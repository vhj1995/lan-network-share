<Window x:Class="LANShare.CSharp.Views.DeviceSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Recipient Device" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Select LAN Target Device" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock Text="Choose the peer device you want to transfer files to:" FontSize="13" Foreground="#A6ADC8" Margin="0,5,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                 Background="#181825" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,15">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#A6E3A1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="#BAC2DE"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Send" Command="{Binding ConfirmCommand}" IsDefault="True" Width="90" Height="34" Margin="0,0,10,0"
                    Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>

            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Width="90" Height="34"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
