<Window x:Class="LANShare.CSharp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LANShare.CSharp.ViewModels"
        Title="LAN Network Share - Windows File Transfer" Height="680" Width="1100"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#11111B" Foreground="#CDD6F4">

    <Window.Resources>
        <vm:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <vm:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <vm:DirectionToIconConverter x:Key="DirectionToIconConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Bar / Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Content Body -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR / TOOLBAR -->
        <Border Grid.Row="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#89B4FA" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#11111B"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LAN Network Share" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4"/>
                        <TextBlock Text="High-Speed Local File Transfer" FontSize="11" Foreground="#A6ADC8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Toolbar Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SendFileCommand}" Margin="0,0,10,0" Padding="14,8"
                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 Send File" Margin="0,0,4,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SendFolderCommand}" Margin="0,0,10,0" Padding="14,8"
                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 Send Folder" Margin="0,0,4,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenDownloadFolderCommand}" Margin="0,0,10,0" Padding="12,8"
                            Background="#89B4FA" Foreground="#11111B" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="📥 Open Downloads"/>
                    </Button>

                    <Button Command="{Binding RefreshPeersCommand}" Margin="0,0,10,0" Padding="10,8"
                            Background="#89B4FA" Foreground="#11111B" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="🔄 Refresh"/>
                    </Button>

                    <Button Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0" Padding="10,8"
                            Background="#89B4FA" Foreground="#11111B" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="⚙️ Settings"/>
                    </Button>

                    <Button Command="{Binding OpenAboutCommand}" Padding="10,8"
                            Background="#89B4FA" Foreground="#11111B" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="ℹ️ About"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT BODY -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <!-- Sidebar: Discovered Peers -->
                <ColumnDefinition Width="16"/>
                <!-- Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Main: Active Transfers -->
            </Grid.ColumnDefinitions>

            <!-- 1) DISCOVERED LAN PEERS SIDEBAR -->
            <Border Grid.Column="0" Background="#181825" CornerRadius="12" BorderBrush="#313244" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Discovered LAN Peers" FontSize="15" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                            <Border Background="#313244" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DiscoveredPeers.Count, StringFormat={}{0} online}" FontSize="11" Foreground="#A6E3A1" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Active devices broadcasting on your network" FontSize="11" Foreground="#A6ADC8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Peers List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding DiscoveredPeers}" SelectedItem="{Binding SelectedPeer}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E2E" CornerRadius="8" BorderBrush="#313244" BorderThickness="1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Indicator -->
                                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#A6E3A1" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Device Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="#BAC2DE" Margin="0,0,8,0"/>
                                                <Border Background="#313244" CornerRadius="4" Padding="4,1">
                                                    <TextBlock Text="{Binding OperatingSystem}" FontSize="10" Foreground="#A6ADC8"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Send Action Button -->
                                        <Button Grid.Column="2" Content="Send" Command="{Binding DataContext.SendToPeerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Padding="10,5" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="11" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 2) & 3) TRANSFERS PROGRESS LIST / CARDS -->
            <Border Grid.Column="2" Background="#181825" CornerRadius="12" BorderBrush="#313244" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Active Transfers &amp; Progress" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" Content="Clear Finished" Command="{Binding ClearCompletedCommand}"
                                Padding="12,5" Background="#89B4FA" Foreground="#111111" FontSize="12" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Transfers Cards List -->
                    <ListView Grid.Row="1" ItemsSource="{Binding ActiveTransfers}" SelectedItem="{Binding SelectedTransfer}"
                              Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E2E" CornerRadius="10" BorderBrush="#313244" BorderThickness="1" Padding="16,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Info Row -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Direction Badge -->
                                            <Border Grid.Column="0" CornerRadius="6" Padding="8,4" Background="#313244" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Direction, Converter={StaticResource DirectionToIconConverter}}" FontSize="11" FontWeight="Bold" Foreground="#89B4FA"/>
                                            </Border>

                                            <!-- File & Peer Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Bold" Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#BAC2DE" Margin="0,2,0,0">
                                                    <Run Text="Peer: "/>
                                                    <Run Text="{Binding Peer.DisplayName}" FontWeight="Bold" Foreground="#CDD6F4"/>
                                                    <Run Text="  •  Total Size: "/>
                                                    <Run Text="{Binding TotalSize, Converter={StaticResource BytesToSizeConverter}}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Speed & Status -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                                <TextBlock Text="{Binding SpeedText}" FontSize="13" FontWeight="Bold" Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Cancel Action Button -->
                                            <Button Grid.Column="3" Content="✕" Command="{Binding DataContext.CancelTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Width="26" Height="26" Background="#313244" Foreground="#F38BA8" FontWeight="Bold" FontSize="12" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" Margin="8,0,0,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>

                                        <!-- Progress Bar Row -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ProgressBar Grid.Column="0" Value="{Binding Progress}" Maximum="100" Height="8" Foreground="#89B4FA" Background="#11111B" BorderThickness="0">
                                                <ProgressBar.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </ProgressBar.Resources>
                                            </ProgressBar>

                                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0.0}%}" FontSize="12" FontWeight="Bold" Foreground="#89B4FA" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#181825" BorderBrush="#313244" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#A6E3A1" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#A6ADC8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Developed with ❤️ by Vaibhav Joshi" FontSize="12" FontWeight="Bold" Foreground="#F38BA8"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LocalIpAddress, StringFormat={}Local IP: {0}}" FontSize="12" Foreground="#89B4FA" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
